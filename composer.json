{
    "name": "mathrix/openapi-tester",
    "description": "PHPUnit extension to test on OpenAPI specification in functional tests.",
    "type": "library",
    "require": {
        "php": ">=7.1",
        "phpunit/phpunit": "^8.1",
        "psr/http-message": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Mathrix\\OpenAPI\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mathrix\\OpenAPI\\": "tests"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mathieu Bour",
            "email": "mathieu@mathrix.fr"
        }
    ],
    "require-dev": {
        "symfony/var-dumper": "^4.2"
    }
}
